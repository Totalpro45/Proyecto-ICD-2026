# Configuración de variables de entorno para el proyecto ICD 2026
# Copia este archivo a .env y completa los valores reales.
# NO subas el archivo .env a GitHub (ya está en .gitignore).

# Clave API de elTOQUE (rol anon). Obtén la tuya en:
# https://tasas-token.eltoque.com/
# Nunca compartas esta clave ni la subas a repositorios públicos.
ELTOQUE_API_TOKEN=tu_api_key_de_eltoque_aqui

# URL base de la API de elTOQUE (no modificar salvo que elTOQUE la cambie)
ELTOQUE_API_BASE_URL=https://tasas.eltoque.com
